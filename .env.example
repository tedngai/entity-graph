# Copy to .env and adjust. Loaded by entity_graph.config via python-dotenv.

# --- PostgreSQL (matches docker-compose.yml) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=entity_graph
PG_USER=postgres
PG_PASSWORD=postgres

# --- Extraction backend: baseline | spacy | gliner2 ---
EXTRACTION_BACKEND=baseline

# --- GLiNER2 (primary extractor; requires pip install "gliner2[local]") ---
# device: auto (cuda if available, else cpu) | cpu | cuda
GLINER_MODEL=fastino/gliner2.5-base-v1
GLINER_DEVICE=auto
GLINER_THRESHOLD=0.4

# --- Long-document chunking (sentence windows with overlap) ---
# Documents longer than one window are split before extraction; mention offsets
# are rebased to the full document afterwards.
CHUNK_MAX_SENTENCES=8
CHUNK_OVERLAP_SENTENCES=2
CHUNK_MAX_CHARS=1200

# --- Jev / System One typed decisions (TypeSafe) ---
# Used for entity alignment, type arbitration, and relation validation.
# Leave every key empty to skip Jev calls (exact/alias/trigram resolution only).
#
# Option A — Pratt router (preferred on this machine; key already in .env):
#   PRATT_LLM_API_KEY=...
#   (-> https://llm.pratt.edu/v1/systemone, model pratt-jev)
# Option B — native TypeSafe key:
#   SYSTEMONE_API_KEY=...
#   SYSTEMONE_URL=https://api.typesafe.ai/v1/systemone
#   SYSTEMONE_MODEL=jev-latest
# Option C — OpenRouter key (endpoint + model are inferred automatically):
#   OPENROUTER_API_KEY=...
#   (-> https://openrouter.ai/api/alpha/decisions, model typesafe/jev-1.13)
# Precedence: SYSTEMONE_API_KEY > PRATT_LLM_API_KEY > OPENROUTER_API_KEY.
# Optional overrides (defaults are inferred from whichever key you set above):
#   SYSTEMONE_URL=https://llm.pratt.edu/v1/systemone
#   SYSTEMONE_MODEL=pratt-jev
# Pin the model in production (jev-1.13.0) so calibrated thresholds don't drift.
# Optional OpenRouter attribution headers:
#   OPENROUTER_REFERER=https://example.com
#   OPENROUTER_TITLE=entity-graph
SYSTEMONE_API_KEY=
PRATT_LLM_API_KEY=
OPENROUTER_API_KEY=

# --- LLM escalation (PROGRESS P4.5; opt-in) ---
# An LLM is used only to re-extract documents the cheap pass flags as uncertain
# (no mentions, no relations, or mostly low-confidence mentions). Requires an
# OpenAI-compatible chat-completions endpoint.
# Pratt router is preferred when PRATT_LLM_API_KEY is set; otherwise OpenRouter.
LLM_MODEL=pratt-medium
LLM_URL=https://llm.pratt.edu/v1/chat/completions
LLM_API_KEY=
# EXTRACTION_ESCALATE=true (or --escalate) turns the wrapper on.
EXTRACTION_ESCALATE=false
ESCALATION_CONFIDENCE=0.5

# --- Output ---
OUT_DIR=out
